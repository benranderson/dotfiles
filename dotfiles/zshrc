#
# Executes commands at the start of an interactive session.
#

# activate homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# source Prezto
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# ensure packages are only installed in an active virtual environment
export PIP_REQUIRE_VIRTUALENV=true
export PATH="$PATH:/Users/benranderson/.local/bin:/Users/benranderson/dev/github/personal/dotfiles/bin"

# aliases
# swtich to branch
alias gs="git switch"
# switch to new branch
alias gnb="git switch -c"
# create worktree and open it; branches off HEAD, or checks out $1 if it already exists
gwa() { git worktree add ".worktrees/$1" && code ".worktrees/$1"; }
# remove worktree and branch; extra args pass to git worktree remove, e.g. gwr foo --force
gwr() { local b=$1; shift; git worktree remove "$@" ".worktrees/$b" && git branch -d "$b"; }
# stage and commit all changes
alias gac="git add -A && uv run git commit -m"
# pull updates from origin
alias gpl="git pull"
# push all changes, including tags, to origin
alias gp="git push --follow-tags"
# delete local branch
alias gdb="git branch -D"
# delete online branch
alias gdob="git push origin -d"
# rename branch
alias grb="git branch -m"
# rebase current branch on main branch
alias grm="git rebase main"
# undo last commit
alias guc="git reset --soft HEAD~1"
# list commits on current branch since main
alias lsc="git --no-pager log main..HEAD --oneline"
# list outdated python packages
alias plo="uv pip list --outdated"
# remove information on branches that were deleted on origin
alias gfp="git fetch --prune"
# list commit messages since branch creation
alias glc='git log --oneline --format="- %s" main..'
# open terminal a current working directory
alias term="open -a Terminal"
# run script to open work apps
alias work="./.work.sh"
# run script to update tools
alias update="./.update-tools.sh"
# run script to clear caches
alias clearcaches="./.clear-caches.sh"
# run pre-commit hooks on all files
alias pra="prek run --all-files"
# get ip address of primary network interface
alias gip="ipconfig getifaddr en0"
# run learn AI learning system in pi
alias learn='cd ~/Library/Mobile\ Documents/iCloud~md~obsidian/Documents/Vault/π/learn && pi'

# pip zsh completion
function _pip_completion {
  local words cword
  read -Ac words
  read -cn cword
  reply=( $( COMP_WORDS="$words[*]" \
             COMP_CWORD=$(( cword-1 )) \
             PIP_AUTO_COMPLETE=1 $words[1] 2>/dev/null ))
}
compctl -K _pip_completion pip

# configure SnowSQL
alias snowsql=/Applications/SnowSQL.app/Contents/MacOS/snowsql

# configure AWS CLI
export PATH="/Users/benranderson/Documents/dev/github/dev-tools:$PATH"

# configure ruby
export PATH="/opt/homebrew/opt/ruby/bin:$PATH"

# configure postgresql
export PATH="/opt/homebrew/opt/postgresql@15/bin:$PATH"

# configure nvm (lazy-loaded for faster shell startup)
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh" --no-use
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
